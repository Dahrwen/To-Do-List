# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed to browser via Vite - prefixed with VITE_)
# Stored in: .env.local
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-public-key

# ==============================================================================
# SERVER-SIDE / BACKEND ENVIRONMENT VARIABLES (NEVER exposed to frontend or client)
# Stored in Supabase Dashboard (Project Settings -> Edge Functions -> Secrets)
# ==============================================================================
# Google Cloud Console OAuth 2.0 Credentials (with Google Classroom API enabled)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Supabase Service Role Key (Used exclusively by server functions to bypass RLS for token sync)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
